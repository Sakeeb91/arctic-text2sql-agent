# HuggingFace Configuration
HUGGINGFACE_TOKEN=your_hf_token_here
MODEL_NAME=Snowflake/snowflake-arctic-embed-m-v2.0
TEXT2SQL_MODEL=Snowflake/Arctic-Text2SQL-R1-7B

# Database Configuration
DATABASE_URL=sqlite:///./text2sql.db
# For production: postgresql://user:password@localhost:5432/text2sql_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
LOG_LEVEL=info

# Model Configuration
MODEL_DEVICE=cuda  # or 'cpu' or 'mps' for Mac
MODEL_MAX_LENGTH=2048
MODEL_BATCH_SIZE=1
ENABLE_8BIT_QUANTIZATION=false

# Security
API_KEY_ENABLED=false
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Cache Configuration
ENABLE_QUERY_CACHE=true
CACHE_TTL_SECONDS=3600

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
